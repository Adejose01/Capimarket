{
  "name": "CapiMarket Development Environment",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "frontend",
  "workspaceFolder": "/workspace",
  
  // Define el usuario remoto y fuerza la ejecución con permisos adecuados
  "remoteUser": "node",
  "containerUser": "node",

  // Forzar a Dev Containers a realizar la compilación local de las features sin buscar en Docker Hub
  "build": {
    "options": ["--no-cache"]
  },

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true,
        "eslint.validate": [
          "javascript",
          "javascriptreact",
          "typescript",
          "typescriptreact"
        ]
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker",
        "mechatroner.rainbow-csv",
        "esbenp.prettier-vscode",
        "dracula-theme.theme-dracula",
        "Continue.continue"
      ]
    }
  },

  // Al usar node:22-bookworm-slim, Git ya viene incluido en el sistema base.
  // Remover la feature de git evita la necesidad de recompilar la imagen al vuelo.
  "features": {},

  "postCreateCommand": "cd /workspace/apps/frontend && npm install",
  "postAttachCommand": "cd /workspace/apps/frontend && npm run dev",
  "portsAttributes": {
    "8090": {
      "label": "PocketBase"
    }
  }
}