# =========================================================
# Capimarket - Variables de Entorno para Producción
# =========================================================
# Copia este archivo como .env.production y edita los valores
# =========================================================

# =======================================================
# Frontend Configuration
# =======================================================
# URL de PocketBase (debe ser accessible desde el contenedor frontend)
VITE_PB_URL=http://pocketbase:8090

# =======================================================
# PocketBase Administration
# =======================================================
# Email de administrador de PocketBase
PB_ADMIN_EMAIL=admin@capimercado.com

# Contraseña de administrador de PocketBase (MÍNIMO 12 CARACTERES)
# ¡NUNCA compartir esta contraseña en commit!
# Usa .env.pb_password para gestionar la contraseña de forma segura.
PB_ADMIN_PASSWORD=TODO_MUY_SEGURO_123

# Archivo de contraseña para docker-compose (opcional, mejor práctica)
PB_PASSWORD_FILE=.env.pb_password

# =======================================================
# PocketBase Configuration
# =======================================================
# Dirección del directorio de datos (base de datos SQLite)
PB_DATA_DIR=/pb/pb_data

# Directorio de migraciones
PB_MIGRATIONS_DIR=/pb/pb_migrations

# Directorio de hooks
PB_HOOKS_DIR=/pb/pb_hooks

# =======================================================
# Nginx Configuration
# =======================================================
# Dominios permitidos (puedes tener múltiples, separados por coma)
NGINX_SERVER_NAMES=localhost capimercado.com www.capimercado.com

# =======================================================
# Logging Configuration
# =======================================================
# Nivel de logging (debug, info, warn, error)
LOG_LEVEL=info

# =======================================================
# Application Settings
# =======================================================
# Nombre de la aplicación
APP_NAME=Capimarket

# URL del sitio (para redirecciones y meta tags)
APP_URL=https://capimercado.com

# =======================================================
# Security (Nginx)
# =======================================================
# Habilitar HSTS (HTTP Strict Transport Security)
ENABLE_HSTS=true

# Tiempo de HSTS en segundos (31536000 = 1 año)
HSTS_MAX_AGE=31536000

# =======================================================
# Maintenance Mode (opcional)
# =======================================================
# Habilitar modo de mantenimiento (true/false)
MAINTENANCE_MODE=false
